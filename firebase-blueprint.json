{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "avatar_url": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client", "moderator"] },
        "is_premium": { "type": "boolean" },
        "has_billing": { "type": "boolean" },
        "pdv_access_status": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "role", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "user_id": { "type": "string" }
      },
      "required": ["name"]
    },
    "Subcategory": {
      "title": "Subcategory",
      "description": "Product subcategory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category_id": { "type": "string" },
        "user_id": { "type": "string" }
      },
      "required": ["name", "category_id"]
    },
    "PortfolioProduct": {
      "title": "PortfolioProduct",
      "description": "Portfolio product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "original_price": { "type": "number" },
        "promo_price": { "type": "number" },
        "type": { "type": "string" },
        "category_id": { "type": "string" },
        "subcategory_id": { "type": "string" },
        "user_id": { "type": "string" }
      },
      "required": ["name", "original_price", "type"]
    },
    "PortfolioImage": {
      "title": "PortfolioImage",
      "description": "Portfolio product image",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "product_id": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["product_id", "url"]
    },
    "Theme": {
      "title": "Theme",
      "description": "Theme for products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "image_url": { "type": "string" },
        "user_id": { "type": "string" }
      },
      "required": ["name", "category", "image_url"]
    },
    "MyWork": {
      "title": "MyWork",
      "description": "My work video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "video_url": { "type": "string" },
        "thumbnail_url": { "type": "string" },
        "user_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "video_url"]
    },
    "HomeSettings": {
      "title": "HomeSettings",
      "description": "Home page settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "settings": { "type": "object" }
      }
    },
    "ServiceSettings": {
      "title": "ServiceSettings",
      "description": "Service settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "link": { "type": "string" }
      }
    },
    "ServicePricing": {
      "title": "ServicePricing",
      "description": "Service pricing configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "CompanyInfo": {
      "title": "CompanyInfo",
      "description": "Company information",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "zip": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["user_id"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sale record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "phone": { "type": "string" },
        "total": { "type": "number" },
        "amount_paid": { "type": "number" },
        "payment_method": { "type": "string" },
        "date_time": { "type": "string", "format": "date-time" },
        "items": { "type": "array" }
      },
      "required": ["user_id"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "date_time": { "type": "string", "format": "date-time" },
        "expense_type": { "type": "string" },
        "description": { "type": "string" },
        "observation": { "type": "string" },
        "supplier": { "type": "string" },
        "category": { "type": "string" },
        "total": { "type": "number" },
        "payment_method": { "type": "string" }
      },
      "required": ["user_id", "description", "total"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "full_name": { "type": "string" },
        "cpf": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "object" },
        "dob": { "type": "string" },
        "avatar_url": { "type": "string" },
        "status": { "type": "string" },
        "signup_date": { "type": "string", "format": "date-time" }
      },
      "required": ["full_name"]
    },
    "ResumeConfig": {
      "title": "ResumeConfig",
      "description": "Resume configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "ResumeRequest": {
      "title": "ResumeRequest",
      "description": "Resume request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "user_whatsapp": { "type": "string" },
        "status": { "type": "string" },
        "requested_at": { "type": "string", "format": "date-time" },
        "resume_data": { "type": "object" }
      },
      "required": ["user_name", "user_whatsapp", "status", "resume_data"]
    },
    "Printer": {
      "title": "Printer",
      "description": "Printer configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "connection_type": { "type": "string" },
        "address": { "type": "string" },
        "is_default": { "type": "boolean" }
      },
      "required": ["user_id", "name", "connection_type", "address"]
    },
    "ApostilaSettings": {
      "title": "ApostilaSettings",
      "description": "Apostila printing and binding settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "price_bw": { "type": "number" },
        "price_color": { "type": "number" },
        "price_spiral": { "type": "number" },
        "price_wireo": { "type": "number" },
        "limit_spiral": { "type": "number" },
        "limit_wireo": { "type": "number" },
        "enable_double_sided": { "type": "boolean" },
        "enable_spiral": { "type": "boolean" },
        "enable_wireo": { "type": "boolean" },
        "min_delivery_days": { "type": "number" }
      },
      "required": ["price_bw", "price_color", "price_spiral", "price_wireo"]
    },
    "ApostilaColor": {
      "title": "ApostilaColor",
      "description": "Available cover colors for apostilas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "hex": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "active"]
    },
    "ApostilaOrder": {
      "title": "ApostilaOrder",
      "description": "Apostila order from client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "user_whatsapp": { "type": "string" },
        "print_type": { "type": "string", "enum": ["bw", "color"] },
        "pages": { "type": "integer" },
        "sides": { "type": "string", "enum": ["single", "double"] },
        "binding": { "type": "string", "enum": ["spiral", "wireo"] },
        "cover_color": { "type": "string" },
        "delivery_date": { "type": "string", "format": "date" },
        "quantity": { "type": "integer" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["print_type", "pages", "sides", "binding", "quantity", "total", "status"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "User profiles"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories"
    },
    "/subcategories/{subcategoryId}": {
      "schema": { "$ref": "#/entities/Subcategory" },
      "description": "Product subcategories"
    },
    "/portfolio_products/{productId}": {
      "schema": { "$ref": "#/entities/PortfolioProduct" },
      "description": "Portfolio products"
    },
    "/portfolio_images/{imageId}": {
      "schema": { "$ref": "#/entities/PortfolioImage" },
      "description": "Portfolio images"
    },
    "/themes/{themeId}": {
      "schema": { "$ref": "#/entities/Theme" },
      "description": "Themes"
    },
    "/my_works/{workId}": {
      "schema": { "$ref": "#/entities/MyWork" },
      "description": "My works (videos)"
    },
    "/home_settings/{settingId}": {
      "schema": { "$ref": "#/entities/HomeSettings" },
      "description": "Home settings"
    },
    "/service_settings/{settingId}": {
      "schema": { "$ref": "#/entities/ServiceSettings" },
      "description": "Service settings"
    },
    "/service_pricing/{pricingId}": {
      "schema": { "$ref": "#/entities/ServicePricing" },
      "description": "Service pricing"
    },
    "/company_info/{infoId}": {
      "schema": { "$ref": "#/entities/CompanyInfo" },
      "description": "Company info"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sales"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Expenses"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers"
    },
    "/resume_config/{configId}": {
      "schema": { "$ref": "#/entities/ResumeConfig" },
      "description": "Resume config"
    },
    "/resume_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ResumeRequest" },
      "description": "Resume requests"
    },
    "/printers/{printerId}": {
      "schema": { "$ref": "#/entities/Printer" },
      "description": "Printers"
    },
    "/apostila_settings/{settingId}": {
      "schema": { "$ref": "#/entities/ApostilaSettings" },
      "description": "Apostila settings"
    },
    "/apostila_colors/{colorId}": {
      "schema": { "$ref": "#/entities/ApostilaColor" },
      "description": "Apostila cover colors"
    },
    "/apostila_orders/{orderId}": {
      "schema": { "$ref": "#/entities/ApostilaOrder" },
      "description": "Apostila orders"
    }
  }
}
