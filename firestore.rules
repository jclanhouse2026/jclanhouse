rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID)
    // Fields:
    //   - name: string (required)
    //   - username: string (optional)
    //   - role: string ('admin', 'moderator', 'client')
    //   - avatar_url: string (optional)
    //   - status: string ('active', 'inactive')
    //
    // Collection: orders
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - UID of the user who placed the order
    //   - customerName: string (required)
    //   - customerPhone: string (required)
    //   - address: map (required) - Address object
    //   - items: list (required) - List of OrderItem objects
    //   - totalAmount: number (required)
    //   - status: string ('pending', 'processing', 'shipped', 'delivered', 'cancelled', 'completed')
    //   - createdAt: string (required) - ISO date string
    //
    // Collection: apostila_orders
    // Document ID: auto-generated
    // Fields:
    //   - user_id: string (required)
    //   - user_name: string (required)
    //   - title: string (optional)
    //   - total: number (required)
    //   - status: string (required)
    //   - created_at: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "lanjc0245@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) ||
        (resource != null && 'user_id' in resource.data && request.auth.uid == resource.data.user_id)
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.customerName is string && data.customerName.size() > 0 &&
             data.customerPhone is string && data.customerPhone.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled', 'completed'] &&
             data.items is list && data.items.size() > 0;
    }

    function isValidApostilaOrder(data) {
      return data.user_id is string && data.user_id.size() > 0 &&
             data.user_name is string && data.user_name.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'completed', 'cancelled'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if (isAuthenticated() && isOwner(userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /my_works/{workId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /home_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /service_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /service_pricing/{pricingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /company_info/{infoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAdmin();
    }

    match /resume_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resume_requests/{requestId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAdmin();
    }

    match /user_resumes/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAdmin();
    }

    match /mug_orders/{orderId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAdmin();
    }

    match /printers/{printerId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAuthenticated() && (isDocOwner() || isAdmin());
    }

    match /apostila_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apostila_colors/{colorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apostila_orders/{orderId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || isAdmin()) && isValidApostilaOrder(request.resource.data);
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin()) && isValidApostilaOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin()) && isValidOrder(request.resource.data);
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin()) && isValidOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin());
      allow delete: if isAuthenticated() && (isDocOwner() || isAdmin());
    }
  }
}
